{
  "name": "day-by-day",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174",
    "build": "vite build && node scripts/stamp-service-worker.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 5174",
    "check": "tsc --noEmit",
    "lint": "eslint web/src",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node scripts/test-pages.mjs && node scripts/test-sync.mjs && node scripts/test-progress.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "lucide-react": "^1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/parser": "8.71.1",
    "@vitejs/plugin-react": "6.0.2",
    "esbuild": "0.27.4",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.9",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
